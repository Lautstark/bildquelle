{
  "name": "@lautstark/bildquelle",
  "version": "1.3.1",
  "type": "module",
  "description": "Symbol search for German AAC tools: ARASAAC's public API and the user's own licensed METACOM folder, behind one browser-only interface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lautstark/bildquelle.git"
  },
  "keywords": [
    "aac",
    "arasaac",
    "metacom",
    "pictograms",
    "symbols"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./german": {
      "types": "./dist/german/index.d.ts",
      "default": "./dist/german/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build && npm run build:browser",
    "build:browser": "esbuild src/index.ts src/german/index.ts --bundle --format=esm --splitting --outdir=dist/browser --target=es2022 --sourcemap",
    "preversion": "npm run typecheck && npm test && npm run build && npm run build:browser"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
